# ── Required ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change-this-database-password
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: local | s3
STORAGE_BACKEND=local

# S3 / MinIO (required when STORAGE_BACKEND=s3)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=raidreplay
# S3_ENDPOINT=http://minio:9000   # omit for AWS S3

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API, or * for all
CORS_ORIGIN=*

# ── WarcraftLogs (optional) ───────────────────────────────────────────────────
# WCL_CLIENT_ID=
# WCL_CLIENT_SECRET=
