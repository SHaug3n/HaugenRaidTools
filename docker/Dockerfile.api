FROM node:22-alpine AS base
WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────────────────────
FROM base AS deps
COPY package*.json ./
RUN npm ci --omit=dev

# ── Build ─────────────────────────────────────────────────────────────────────
FROM base AS build
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src/ ./src/
COPY scripts/ ./scripts/
RUN npx tsc

# ── Production image ──────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# api/spec/openapi.yaml is generated by `npm run generate:spec` and committed to the repo.
# Copy it into the image when it exists (optional — the server generates the spec dynamically at /api/openapi.yaml).
# COPY api/ ./api/

EXPOSE 3000

CMD ["node", "dist/src/server.js"]
