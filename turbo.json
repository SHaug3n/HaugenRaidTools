{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "api/spec/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:spec": {
      "outputs": ["api/spec/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
